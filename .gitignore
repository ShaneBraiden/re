__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/
venc/
.env
temp/
paper/
experiments/

# Run outputs are regenerated from configs. Only the manifest and the metrics
# table are tracked - section 7 ships the metrics table as a release artefact
# alongside the paper.
#
# Note the shape: git will not descend into an excluded *directory*, so the
# directories must be re-included before any file inside them can be.
experiments/**
!experiments/.gitkeep
!experiments/*/
!experiments/*/manifest.json
!experiments/*/metrics.csv
!experiments/*/validation.json
experiments/*/metrics.previous.csv

# Corpus data is downloaded or generated, never committed.
data/
weights/

# Checkpoints are downloaded (sensorsim weights fetch) or trained (sensorsim
# train nc-dce) and pinned by SHA-256. The training sidecars, which record the
# hash and the config, are small and tracked.
models/*.pth
models/*.part

# Backups the LaTeX writer makes before every edit of the paper.
paper/overleaf/*.bak-*

# Reports written by sensorsim enhance / paper-nag.
temp/enhance_*/
temp/nag_method_report/

# Figures are regenerated by analyze/figures.py - never hand-made, never tracked.
paper/figures/**
!paper/figures/.gitkeep

notebooks/.ipynb_checkpoints/
